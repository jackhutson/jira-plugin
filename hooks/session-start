#!/usr/bin/env bash
# Thin SessionStart adapter for the deterministic Jira plugin helper.

set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

escape_for_json() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

emit_context() {
    local escaped_message
    escaped_message=$(escape_for_json "$1")
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped_message"
}

if ! command -v node >/dev/null 2>&1; then
    emit_context "Jira Plugin: Node.js 22 or newer is required. Install Node.js, then restart Claude Code."
    exit 0
fi

helper_path="${CLAUDE_PLUGIN_ROOT}/scripts/jira-plugin.mjs"
if helper_output=$(node "$helper_path" doctor --hook-json 2>/dev/null); then
    printf '%s\n' "$helper_output"
else
    emit_context "Jira Plugin: The runtime helper failed before it could check ACLI. Reinstall the plugin or run node ${helper_path} doctor --json."
fi

exit 0
