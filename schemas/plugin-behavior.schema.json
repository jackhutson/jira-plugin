{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackhutson/jira-plugin/schemas/plugin-behavior.schema.json",
  "title": "Jira plugin model evaluations",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "category", "prompt", "expected"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "category": {"type": "string", "minLength": 1},
      "prompt": {"type": "string", "minLength": 1},
      "expected": {
        "type": "object",
        "required": ["decision", "maxChars"],
        "properties": {
          "decision": {"type": "string", "minLength": 1},
          "contains": {"type": "array", "items": {"type": "string"}},
          "notContains": {"type": "array", "items": {"type": "string"}},
          "maxChars": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  }
}
